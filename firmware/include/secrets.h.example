// Copy this file to secrets.h (gitignored) and fill in your real WiFi
// credentials. secrets.h itself must never be committed.
#pragma once

#define WIFI_SSID "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Credentials for the fallback AP the firmware hosts if it can't join the
// network above -- see HOW_TO_USE.md. Change the password from the
// placeholder; anyone in range of the default can control the robot.
#define AP_SSID "hexapod-cv-fallback"
#define AP_PASSWORD "change-me-before-flashing"

// OTA update password (ArduinoOTA). Change this too -- anyone on the same
// network who knows the hostname can otherwise push firmware to the robot.
#define OTA_PASSWORD "change-me-too"
